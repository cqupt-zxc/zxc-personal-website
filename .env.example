# Browser-safe configuration (required for Production; optional for local demo)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only configuration (required for Production)
ADMIN_EMAILS=you@example.com
PRIVATE_ARCHIVE_PASSWORD=choose_a_long_unique_password
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Optional GitHub project enrichment (username enables enrichment; token is optional)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=github_fine_grained_read_only_token
